<Layout>
  <div class="w-full h-full items-center justify-center flex">
    <div
      class="w-full h-full flex flex-col items-center justify-center gap-6 text-center"
    >
      <div>
        <h1 class="text-lg pb-2">Completa tu perfil</h1>
        <p>¿Cómo te gustaría usar PetVet Finder?</p>
      </div>

      <HandleCreatingProfileForm client:load />
    </div>
  </div>
</Layout>
