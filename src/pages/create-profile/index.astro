---
import Layout from "@/layouts/Layout.astro"
import { PersonFormGeneralInfo } from "@/components/create-profile/person/person-form-general-info"
import { jwtVerify } from "jose"

export const prerender = false

interface TokenPayload {
	sub: string
	email: string
	username: string
	isTemorary: boolean
	iat: number
	exp: number
}

const token = Astro.cookies.get("tempToken")?.value
let userData = null
let error = false
if (token) {
	try {
		const secret = new TextEncoder().encode(import.meta.env.SECRET_TOKEN)
		const { payload } = await jwtVerify<TokenPayload>(token, secret)
		userData = {
			id: payload.sub,
			fullName: payload.username,
			email: payload.email,
		}
	} catch (error) {
		console.error("Error verifying token: ", error)
		error = true
	}
} else {
	return Astro.redirect("/")
}
---

<Layout>
	{
		error && (
			<div class="w-full h-full flex items-center justify-center">
				<div class="text-center">
					<h1 class="text-2xl font-bold mb-4">Sesión inválida</h1>
					<p class="mb-4">Por favor, inicia sesión nuevamente</p>
					<a href="/" class="text-blue-500 underline">
						Volver al inicio
					</a>
				</div>
			</div>
		)
	}
	{
		userData !== null && (
			<div class="w-full h-full items-center justify-center flex">
				<div class="w-full h-full flex flex-col items-center justify-center gap-6 text-center">
					<PersonFormGeneralInfo client:load userData={userData} />
				</div>
			</div>
		)
	}</Layout
>
